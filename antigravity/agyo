#!/usr/bin/env bash
# Fail-closed launcher for the Antigravity CLI orchestrator.
# agy silently falls back to the default (fully privileged) agent when the requested
# agent is not discovered; this wrapper refuses to launch in that case and re-checks the log on exit.
set -u
AGENT="${AGYO_AGENT:-orchestrator-agent}"
LOGDIR="$HOME/.gemini/antigravity-cli/log"
if ! agy agents 2>/dev/null | grep -qx "$AGENT"; then
  echo "agyo: agent '$AGENT' is not discovered by 'agy agents'. Refusing to launch (it would run the default agent)." >&2
  echo "agyo: discovered agents:" >&2; agy agents 2>&1 | sed 's/^/  /' >&2
  exit 1
fi
before=$(ls -t "$LOGDIR"/cli-*.log 2>/dev/null | head -1)
agy --agent "$AGENT" "$@"; rc=$?
after=$(ls -t "$LOGDIR"/cli-*.log 2>/dev/null | head -1)
if [ -n "$after" ] && [ "$after" != "$before" ] && grep -q 'not found, falling back to default' "$after"; then
  echo "agyo: WARNING — that session ran the DEFAULT agent (log: $after)." >&2
fi
exit $rc

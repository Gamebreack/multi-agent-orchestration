#!/usr/bin/env bash
# Switch all opencode agents' model/variant to a named preset (openai <-> go).
# Assumptions: bash 4+, GNU sed -i, jq, and a running OpenCode CLI (api query at the end).
# Writes the target agent files in place with NO backups: copy this repo's opencode/agents/
# into $OC_AGENTS_DIR first, or back it up. OC_AGENTS_DIR overrides the target (default
# ~/.config/opencode/agents).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PRESETS_DIR="$SCRIPT_DIR/presets"
AGENTS_DIR="${OC_AGENTS_DIR:-$HOME/.config/opencode/agents}"

current_model() {
  grep -m1 '^model:' "$1" | sed 's/^model:[[:space:]]*//'
}
current_variant() {
  grep -m1 '^variant:' "$1" | sed 's/^variant:[[:space:]]*//' || true
}

if [[ $# -eq 0 ]]; then
  echo "Current agent models (in $AGENTS_DIR):"
  declare -A openai_match=() go_match=()
  for f in "$AGENTS_DIR"/*.md; do
    agent="$(basename "$f" .md)"
    model="$(current_model "$f")"
    variant="$(current_variant "$f")"
    printf '  %-18s %-30s %s\n' "$agent" "$model" "${variant:-<none>}"
  done
  for preset in "$PRESETS_DIR"/*.tsv; do
    name="$(basename "$preset" .tsv)"
    match=1
    while IFS=$'\t' read -r agent model variant; do
      [[ "$agent" =~ ^#.*$ || -z "$agent" ]] && continue
      f="$AGENTS_DIR/$agent.md"
      [[ -f "$f" ]] || { match=0; break; }
      [[ "$(current_model "$f")" == "$model" ]] || { match=0; break; }
      want_variant="$variant"; [[ "$want_variant" == "-" ]] && want_variant=""
      [[ "$(current_variant "$f")" == "$want_variant" ]] || { match=0; break; }
    done < "$preset"
    [[ $match -eq 1 ]] && echo "Matches preset: $name"
  done
  exit 0
fi

preset_name="$1"
preset_file="$PRESETS_DIR/$preset_name.tsv"
if [[ ! -f "$preset_file" ]]; then
  echo "Unknown preset: $preset_name" >&2
  echo "Available presets:" >&2
  for p in "$PRESETS_DIR"/*.tsv; do
    basename "$p" .tsv >&2
  done
  exit 1
fi

while IFS=$'\t' read -r agent model variant; do
  [[ "$agent" =~ ^#.*$ || -z "$agent" ]] && continue
  f="$AGENTS_DIR/$agent.md"
  if [[ ! -f "$f" ]]; then
    echo "Warning: no agent file for '$agent', skipping" >&2
    continue
  fi
  esc_model="$(printf '%s' "$model" | sed 's/[\/&]/\\&/g')"
  sed -i "s/^model:.*/model: $esc_model/" "$f"
  if [[ "$variant" == "-" ]]; then
    sed -i '/^variant:/d' "$f"
  elif grep -q '^variant:' "$f"; then
    sed -i "s/^variant:.*/variant: $variant/" "$f"
  else
    sed -i "/^model:/a variant: $variant" "$f"
  fi
  if [[ "$variant" == "-" ]]; then
    echo "Set $agent -> $model"
  else
    echo "Set $agent -> $model ($variant)"
  fi
done < "$preset_file"

echo "Waiting for hot reload..."
sleep 3
opencode api GET /api/agent 2>/dev/null | jq -r '.data[] | select(.mode!=null) | "\(.name)\t\(.model.providerID // "-")/\(.model.id // "-")\t\(.model.variant // "-")"' | sort
echo "If any agent above still shows its old model, run: opencode service restart"

#!/usr/bin/env bash
# Switch all opencode agents' model to a named preset (openai <-> go).
# Agent files use the merged model form: model: provider/model[#variant], which is
# exactly what the preset TSVs store in their model column (2 columns: agent<TAB>model).
# Assumptions: bash 4+, GNU sed -i, jq, and a running OpenCode CLI (api query at the end).
# Writes the target agent files in place with NO backups: copy this repo's opencode/agents/
# into $OC_AGENTS_DIR first, or back it up. OC_AGENTS_DIR overrides the target (default
# ~/.config/opencode/agents).
# Target agent files should be V2 form (merged model line); leftover variant: lines are removed on switch.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PRESETS_DIR="$SCRIPT_DIR/presets"
AGENTS_DIR="${OC_AGENTS_DIR:-$HOME/.config/opencode/agents}"

current_model() {
  grep -m1 '^model:' "$1" | sed 's/^model:[[:space:]]*//'
}

if [[ $# -eq 0 ]]; then
  echo "Current agent models (in $AGENTS_DIR):"
  for f in "$AGENTS_DIR"/*.md; do
    agent="$(basename "$f" .md)"
    model="$(current_model "$f")"
    printf '  %-18s %s\n' "$agent" "$model"
  done
  for preset in "$PRESETS_DIR"/*.tsv; do
    name="$(basename "$preset" .tsv)"
    match=1
    while IFS=$'\t' read -r agent model; do
      [[ "$agent" =~ ^#.*$ || -z "$agent" ]] && continue
      f="$AGENTS_DIR/$agent.md"
      [[ -f "$f" ]] || { match=0; break; }
      [[ "$(current_model "$f")" == "$model" ]] || { match=0; break; }
    done < "$preset"
    [[ $match -eq 1 ]] && echo "Matches preset: $name"
  done
  exit 0
fi

preset_name="$1"
preset_file="$PRESETS_DIR/$preset_name.tsv"
if [[ ! -f "$preset_file" ]]; then
  echo "Unknown preset: $preset_name" >&2
  echo "Available presets:" >&2
  for p in "$PRESETS_DIR"/*.tsv; do
    basename "$p" .tsv >&2
  done
  exit 1
fi

while IFS=$'\t' read -r agent model; do
  [[ "$agent" =~ ^#.*$ || -z "$agent" ]] && continue
  f="$AGENTS_DIR/$agent.md"
  if [[ ! -f "$f" ]]; then
    echo "Warning: no agent file for '$agent', skipping" >&2
    continue
  fi
  esc_model="$(printf '%s' "$model" | sed 's/[\/&]/\\&/g')"
  sed -i -e "s/^model:.*/model: $esc_model/" -e "/^variant:/d" "$f"
  echo "Set $agent -> $model"
done < "$preset_file"

echo "Waiting for hot reload..."
sleep 3
echo "If any agent below still shows its old model, run: opencode service restart"
opencode api get /api/agent 2>/dev/null | jq -r '.data[] | select(.mode!=null) | "\(.name)\t\(.model.providerID // "-")/\(.model.id // "-")\t\(.model.variant // "-")"' | sort || true

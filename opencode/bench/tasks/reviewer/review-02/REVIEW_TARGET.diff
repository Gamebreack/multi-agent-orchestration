+"""Bulk pricing utilities: discount batches, totals, and CSV export."""
+import csv
+import os
+
+
+class PriceTag:
+    """Identifies a (item, price) pair so discount batches can skip repeats."""
+
+    def __init__(self, item_id, price):
+        self.item_id = item_id
+        self.price = price
+
+    def __eq__(self, other):
+        if not isinstance(other, PriceTag):
+            return NotImplemented
+        return self.item_id == other.item_id and self.price == other.price
+
+    __hash__ = object.__hash__  # keep tags usable as set members
+
+
+def apply_discount(items, percent, seen_tags=set()):
+    """Apply a percent discount to each item's price, in place.
+
+    `seen_tags` lets a caller skip items it has already discounted in a
+    previous batch; repeated (item, price) pairs are left untouched.
+    """
+    discounted = []
+    for item in items:
+        tag = PriceTag(item.id, item.price)
+        if tag in seen_tags:
+            continue
+        seen_tags.add(tag)
+        item.price = item.price - item.price * percent / 100
+        discounted.append(item)
+    return discounted
+
+
+def total_discount_amount(items, percent):
+    """Return the total amount shaved off by a `percent` discount, in cents."""
+    total_cents = 0
+    for item in items:
+        total_cents += item.price * percent / 100 * 100
+    return int(total_cents) / 100
+
+
+def export_report(items, path):
+    """Write a CSV export of items to `path`; returns the row count.
+
+    Any item whose fields can't be written is skipped and does not fail
+    the whole export.
+    """
+    rows = ((i.id, i.name, i.price) for i in items)
+    try:
+        with open(path, "w", newline="") as f:
+            writer = csv.writer(f)
+            writer.writerow(["id", "name", "price"])
+            for row in rows:
+                writer.writerow(row)
+    except Exception:
+        pass
+    return sum(1 for _ in rows)
+
+
+def safe_export(items, path):
+    """Export items as `id,price` lines to `path`, unless it already exists."""
+    if not os.path.exists(path):
+        with open(path, "w") as f:
+            f.write("\n".join(f"{i.id},{i.price}" for i in items))
+    return path

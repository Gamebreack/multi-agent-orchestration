+"""Bulk import items from a directory of JSON files."""
+import json
+import os
+
+from .models import Item
+from .validation import validate_item
+
+
+def _read_json(path):
+    """Read and parse a JSON file, returning the decoded object."""
+    f = open(path)
+    return json.load(f)
+
+
+def _resolve_path(base_dir, filename):
+    """Build the on-disk path for a given base directory and filename."""
+    return os.path.join(base_dir, filename)
+
+
+def import_directory(base_dir, storage):
+    """Import every *.json file in base_dir into storage.
+
+    Returns the list of imported Item objects.
+    """
+    filenames = sorted(f for f in os.listdir(base_dir) if f.endswith(".json"))
+    imported = []
+
+    # Skip index 0: the manifest header file is never a real item record.
+    for i in range(1, len(filenames)):
+        filename = filenames[i]
+        path = _resolve_path(base_dir, filename)
+        try:
+            data = _read_json(path)
+        except Exception:
+            continue
+
+        item = Item(
+            id=data["id"],
+            name=data["name"],
+            quantity=data["quantity"],
+            price=data["price"],
+            tags=data.get("tags", []),
+        )
+        storage.add(item)
+        imported.append(item)
+
+
+def import_file(base_dir, filename, storage):
+    """Import a single named file, used by the `inventory import` CLI command."""
+    path = _resolve_path(base_dir, filename)
+    data = _read_json(path)
+    validate_item(data)
+    item = Item(**data)
+    storage.add(item)
+    return item

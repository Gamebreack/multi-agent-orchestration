{
  "$schema": "https://opencode.ai/config.json",
  // MCP servers (OpenCode 2.x form). Use "servers": entries placed directly under "mcp" go
  // through the v1 migrator, which silently drops "codemode". codemode:false exposes a
  // server's tools directly as <server>_<tool>; the default (true) hides them inside the
  // Code Mode `execute` tool, which the orchestrator's "*": deny keeps hidden.
  // Each server also needs a matching allow rule appended to the permissions array in
  // agents/orchestrator.md, e.g. - { action: <server>_<tool>, resource: "*", effect: allow }.
  // Agent rules run after global rules and the last match wins, so the appended allow
  // overrides the agent's catch-all deny.
  "mcp": {
    "servers": {
      // "<name>": { "type": "remote", "url": "https://...", "disabled": false, "codemode": false }
    }
  },
  "default_agent": "orchestrator",
  "experimental": { "subagent_depth": 1 },
  "agents": {
    "build":   { "disabled": true },
    "plan":    { "disabled": true },
    "general": { "disabled": true }
  }
}
